{
  "manifest_version": 3,
  "name": "本地 HTML 批注",
  "version": "1.6.0",
  "description": "高亮和评论本地 HTML，通过本机助手直接覆盖保存，无需选择原文件。",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["file:///*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "本地 HTML 批注 · 使用说明" },
  "content_scripts": [{
    "matches": ["file:///*"],
    "js": ["core.js", "editor.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
