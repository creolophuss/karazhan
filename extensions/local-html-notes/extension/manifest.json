{
  "manifest_version": 3,
  "name": "本地 HTML 批注",
  "version": "1.3.0",
  "description": "高亮和评论本地 HTML，记住文件授权并保存回原文件。无备份，无服务。",
  "host_permissions": ["file:///*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "本地 HTML 批注 · 使用说明" },
  "content_scripts": [{
    "matches": ["file:///*"],
    "js": ["core.js", "editor.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
